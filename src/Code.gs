    var dates = filterByAthlete(readRows(SpreadsheetApp.getActiveSpreadsheet(), SHEETS.logs), LOG_HEADERS.length - 1, athleteId).map(function(r) { return String(r[2] || '').slice(0, 10); }).filter(function(d) { return /^\d{4}-\d{2}-\d{2}$/.test(d); }).sort();
