  function fmtDate_(s) { if (!s) return '-'; var dt = new Date(s + 'T00:00:00'); var months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des']; return dt.getDate() + ' ' + months[dt.getMonth()] + ' ' + dt.getFullYear(); }
