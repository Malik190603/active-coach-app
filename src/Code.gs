function gHas_(o, k) { return o && Object.prototype.hasOwnProperty.call(o, k); }
function garageToday_() { return appDateKey_(new Date()); }
function garageIsRide_(a) { return /ride/i.test(String((a && (a.sport_type || a.type)) || '')); }
function garageWithLock_(fn) {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (e) { throw new Error('Server sedang sibuk, coba lagi sebentar.'); }
  try { return fn(); } finally { try { lock.releaseLock(); } catch (ignore) {} }
}
function setProfileValue_(ss, athleteId, key, value) {
  var sh = ss.getSheetByName(SHEETS.profile), last = sh.getLastRow(), row = 0;
  if (last >= 2) {
    var vals = sh.getRange(2, 1, last - 1, 3).getValues();
    for (var i = 0; i < vals.length; i++) if (normId_(vals[i][0]) === key && normId_(vals[i][2]) === athleteId) { row = i + 2; break; }
  }
  if (row) sh.getRange(row, 1, 1, 3).setValues([[key, value, athleteId]]);
  else sh.appendRow([key, value, athleteId]);
}

/* ---------- Template part default (interval berbasis praktik bengkel umum) ----------
   [key, group, label, intervalKm, intervalDays] — 0 = tanpa jadwal (cukup dicatat). */
function garageDefaultParts_(type) {
  var t = GARAGE_BIKE_TYPES.indexOf(type) >= 0 ? type : 'road';
  var list = [
    ['chain', 'drivetrain', 'Rantai', 3000, 0], ['cassette', 'drivetrain', 'Cassette / Sprocket', 9000, 0], ['chainring', 'drivetrain', 'Chainring', 15000, 0],
    ['crank', 'drivetrain', 'Crankset', 0, 0], ['rd', 'drivetrain', 'Rear Derailleur', 0, 0], ['fd', 'drivetrain', 'Front Derailleur', 0, 0],
    ['shifter', 'drivetrain', 'Shifter / Brake Lever', 0, 0], ['cables', 'drivetrain', 'Kabel & Housing', 6000, 365], ['bb', 'drivetrain', 'Bottom Bracket', 10000, 0],
    ['pads', 'brake', 'Kampas Rem', 2500, 0], ['rotor', 'brake', 'Rotor / Rim Brake Track', 12000, 0], ['brake', 'brake', 'Caliper / Rem', 0, 0], ['bleed', 'brake', 'Minyak Rem (Bleeding)', 0, 365],
    ['tireF', 'wheel', 'Ban Depan', 5000, 0], ['tireR', 'wheel', 'Ban Belakang', 3500, 0], ['sealant', 'wheel', 'Sealant / Ban Dalam', 0, 120],
    ['wheelset', 'wheel', 'Wheelset', 0, 0], ['hubs', 'wheel', 'Servis Hub & Bearing', 10000, 365],
    ['handlebar', 'cockpit', 'Handlebar', 0, 0], ['stem', 'cockpit', 'Stem', 0, 0], ['bartape', 'cockpit', 'Bar Tape / Grip', 8000, 365],
    ['saddle', 'cockpit', 'Saddle', 0, 0], ['seatpost', 'cockpit', 'Seatpost', 0, 0], ['pedal', 'cockpit', 'Pedal', 20000, 0], ['cleat', 'cockpit', 'Cleat', 6000, 0],
    ['frame', 'frame', 'Frame', 0, 0], ['fork', 'frame', 'Fork', 0, 0], ['headset', 'frame', 'Headset', 15000, 365],
    ['lube', 'care', 'Cuci & Lube Rantai', 400, 21], ['tuneup', 'care', 'Tune-up Menyeluruh', 5000, 180]
  ];
  if (t === 'mtb') list.push(['suspF', 'frame', 'Servis Suspensi Depan', 5000, 365], ['suspR', 'frame', 'Servis Shock Belakang', 5000, 365]);
  if (t === 'ebike') list.push(['battery', 'other', 'Baterai & Motor (cek)', 5000, 365]);
  if (t === 'hybrid' || t === 'folding' || t === 'ebike') list = list.filter(function(p) { return p[0] !== 'cleat'; });
  return list.map(function(p) { return { key: p[0], group: p[1], label: p[2], brand: '', model: '', status: 'stock', price: 0, weightG: 0, trackBy: 'odo', installedKm: 0, installedDate: '', intervalKm: p[3], intervalDays: p[4], condition: 'Baik', note: '', custom: false }; });
}

/* ---------- Sanitasi ---------- */
function garageSanitizePart_(src, base) {
  var p = base ? JSON.parse(JSON.stringify(base)) : { key: gId_('P'), group: 'other', label: 'Part', brand: '', model: '', status: 'stock', price: 0, weightG: 0, trackBy: 'odo', installedKm: 0, installedDate: '', intervalKm: 0, intervalDays: 0, condition: 'Baik', note: '', custom: true };
  src = src || {};
  if (gHas_(src, 'label')) p.label = gStr_(src.label, 80) || p.label;
  if (gHas_(src, 'group')) p.group = GARAGE_PART_GROUPS.indexOf(src.group) >= 0 ? src.group : 'other';
  if (gHas_(src, 'brand')) p.brand = gStr_(src.brand, 80);
  if (gHas_(src, 'model')) p.model = gStr_(src.model, 100);
  if (gHas_(src, 'status')) p.status = src.status === 'upgrade' ? 'upgrade' : 'stock';
  if (gHas_(src, 'price')) p.price = gNum_(src.price, 1e11);
  if (gHas_(src, 'weightG')) p.weightG = gNum_(src.weightG, 100000);
  if (gHas_(src, 'trackBy')) p.trackBy = src.trackBy === 'date' ? 'date' : 'odo';
  if (gHas_(src, 'installedKm')) p.installedKm = gNum_(src.installedKm, 1e6);
  if (gHas_(src, 'installedDate')) p.installedDate = gDate_(src.installedDate);
  if (gHas_(src, 'intervalKm')) p.intervalKm = gNum_(src.intervalKm, 1e6);
  if (gHas_(src, 'intervalDays')) p.intervalDays = Math.round(gNum_(src.intervalDays, 3650));
  if (gHas_(src, 'condition')) p.condition = ['Baik', 'Waspada', 'Ganti'].indexOf(String(src.condition)) >= 0 ? String(src.condition) : 'Baik';
  if (gHas_(src, 'note')) p.note = gStr_(src.note, 600);
  if (p.trackBy === 'date' && !p.installedDate) p.trackBy = 'odo';
  return p;
}
function garageSanitizeBike_(src, base) {
  src = src || {};
  var type = gHas_(src, 'type') && GARAGE_BIKE_TYPES.indexOf(src.type) >= 0 ? src.type : (base && base.type) || 'road';
  var b = base ? JSON.parse(JSON.stringify(base)) : { id: gId_('BK'), createdAt: new Date().getTime(), name: '', type: type, brand: '', model: '', year: '', color: '', frameSize: '', gearId: '', odoSource: 'rides', offsetKm: 0, trackFrom: '', includeIndoor: false, price: 0, purchaseDate: '', weightKg: 0, notes: '', photoId: '', retired: false, parts: garageDefaultParts_(type), history: [] };
  b.type = type;
  if (gHas_(src, 'name')) b.name = gStr_(src.name, 80);
  if (gHas_(src, 'brand')) b.brand = gStr_(src.brand, 60);
  if (gHas_(src, 'model')) b.model = gStr_(src.model, 80);
  if (gHas_(src, 'year')) b.year = gStr_(src.year, 4).replace(/\D/g, '');
  if (gHas_(src, 'color')) b.color = /^#[0-9a-f]{6}$/i.test(String(src.color || '')) ? String(src.color) : '';
  if (gHas_(src, 'frameSize')) b.frameSize = gStr_(src.frameSize, 20);
  if (gHas_(src, 'gearId')) b.gearId = gStr_(src.gearId, 40).replace(/[^\w-]/g, '');
  if (gHas_(src, 'odoSource')) b.odoSource = src.odoSource === 'strava' ? 'strava' : 'rides';
  if (gHas_(src, 'offsetKm')) b.offsetKm = gNum_(src.offsetKm, 1e6);
  if (gHas_(src, 'trackFrom')) b.trackFrom = gDate_(src.trackFrom);
  if (gHas_(src, 'includeIndoor')) b.includeIndoor = !!src.includeIndoor;
  if (gHas_(src, 'price')) b.price = gNum_(src.price, 1e11);
  if (gHas_(src, 'purchaseDate')) b.purchaseDate = gDate_(src.purchaseDate);
  if (gHas_(src, 'weightKg')) b.weightKg = gNum_(src.weightKg, 100);
  if (gHas_(src, 'notes')) b.notes = gStr_(src.notes, 1000);
  if (gHas_(src, 'retired')) b.retired = !!src.retired;
  if (b.odoSource === 'strava' && !b.gearId) b.odoSource = 'rides';
  if (!(b.parts instanceof Array)) b.parts = garageDefaultParts_(b.type);
  if (!(b.history instanceof Array)) b.history = [];
  return b;
}

/* ---------- Baca/tulis sheet Garage ---------- */
function garageReadBikes_(ss, athleteId) {
  var sh = ss.getSheetByName(SHEETS.garage), last = sh.getLastRow(), out = [];
  if (last < 2) return out;
  var vals = sh.getRange(2, 1, last - 1, 3).getValues();
  for (var i = 0; i < vals.length; i++) {
    if (normId_(vals[i][1]) !== athleteId || !normId_(vals[i][0])) continue;
    try {
      var b = JSON.parse(String(vals[i][2] || '{}'));
      if (!b || typeof b !== 'object') continue;
      b.id = normId_(vals[i][0]);
      out.push({ row: i + 2, bike: garageSanitizeBike_({}, b) });
    } catch (e) { logError('Garage parse ' + vals[i][0], e, athleteId); }
  }
  out.sort(function(a, b) { return (a.bike.retired ? 1 : 0) - (b.bike.retired ? 1 : 0) || (a.bike.createdAt || 0) - (b.bike.createdAt || 0); });
  return out;
}
function garageFindBike_(list, bikeId) { bikeId = normId_(bikeId); for (var i = 0; i < list.length; i++) if (list[i].bike.id === bikeId) return list[i]; return null; }
function garageWriteBike_(ss, athleteId, bike, row) {
  var sh = ss.getSheetByName(SHEETS.garage);
  bike.updatedAt = new Date().getTime();
  bike.parts = (bike.parts || []).slice(0, GARAGE_MAX_PARTS);
  bike.history = (bike.history || []).sort(function(a, b) { return String(b.date).localeCompare(String(a.date)) || (b.ts || 0) - (a.ts || 0); }).slice(0, GARAGE_MAX_HISTORY);
  var json = JSON.stringify(bike);
  while (json.length > GARAGE_CELL_LIMIT && bike.history.length > 20) { bike.history = bike.history.slice(0, Math.floor(bike.history.length * 0.8)); json = JSON.stringify(bike); }
  if (json.length > GARAGE_CELL_LIMIT) throw new Error('Data sepeda terlalu besar (' + json.length + ' karakter). Kurangi catatan/part.');
  var values = [[bike.id, athleteId, json, new Date()]];
  if (row) sh.getRange(row, 1, 1, 4).setValues(values);
  else sh.getRange(sh.getLastRow() + 1, 1, 1, 4).setValues(values);
  SpreadsheetApp.flush();
  return bike;
}

/* ---------- Migrasi dari format lama (Profil.bikeGarage) ---------- */
function garageMigrateLegacy_(ss, athleteId) {
  var p = profileMap(ss, athleteId);
  if (p.garageMigratedV2 === '1') return;
  var legacy = [];
  try {
    var parsed = JSON.parse(p.bikeGarage || 'null');
    legacy = parsed instanceof Array ? parsed : (parsed && parsed.bikes instanceof Array ? parsed.bikes : []);
  } catch (e) { legacy = []; }
  if (legacy.length && !garageReadBikes_(ss, athleteId).length) {
    var groupMap = { 'Rangka & Fork': 'frame', 'Drivetrain': 'drivetrain', 'Pengereman': 'brake', 'Roda & Ban': 'wheel', 'Cockpit': 'cockpit', 'Lainnya': 'other' };
    var today = garageToday_();
    legacy.slice(0, GARAGE_MAX_BIKES).forEach(function(old, ix) {
      var bike = garageSanitizeBike_({ name: old.name || ('Sepeda ' + (ix + 1)), price: old.price, offsetKm: old.odoKm, trackFrom: today }, null);
      bike.createdAt = new Date().getTime() + ix;
      bike.photoId = normId_(old.photoId);
      if (old.id) bike.id = normId_(old.id);
      if (old.parts instanceof Array && old.parts.length) {
        bike.parts = old.parts.slice(0, GARAGE_MAX_PARTS).map(function(op) {
          var part = garageSanitizePart_({ label: op.label || op.key, group: groupMap[op.group] || 'other', brand: op.brand, model: op.model, status: op.status, price: op.price, weightG: op.weightG, trackBy: 'odo', installedKm: op.installedKm, intervalKm: op.intervalKm, intervalDays: 0, condition: op.condition, note: op.note }, null);
          part.key = normId_(op.key) || part.key; part.custom = false;
          return part;
        });
      }
      garageWriteBike_(ss, athleteId, bike, 0);
    });
    auditEvent('GARAGE_MIGRATED_V2', athleteId, legacy.length + ' bikes');
  }
  setProfileValue_(ss, athleteId, 'garageMigratedV2', '1');
}

/* ---------- Sheet ActivityGear ---------- */
function garageGearSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet(), sh = ss.getSheetByName(SHEETS.activityGear);
  if (!sh) sh = ensureSheet(ss, SHEETS.activityGear, ACTIVITY_GEAR_HEADERS);
  return sh;
}
function garageGearValues_(sh) { var last = sh.getLastRow(); return last < 2 ? [] : sh.getRange(2, 1, last - 1, 5).getValues(); }
/* Upsert batch [[stravaActivityId, gearId], ...] tanpa menyentuh override manual.
   Mengembalikan jumlah baris yang berubah/baru. */
function garageUpsertGear_(athleteId, pairs) {
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  if (!pairs || !pairs.length) return 0;
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) return 0;
  try {
    var sh = garageGearSheet_(), vals = garageGearValues_(sh), index = {}, changed = 0, dirty = false, now = new Date(), add = [], seenNew = {};
    for (var i = 0; i < vals.length; i++) index[normId_(vals[i][1]) + '|' + normId_(vals[i][0])] = i;
    pairs.forEach(function(pr) {
      var id = normId_(pr[0]), gear = normId_(pr[1]);
      if (!id) return;
      var k = athleteId + '|' + id;
      if (index[k] !== undefined) {
        var r = vals[index[k]];
        if (normId_(r[2]) !== gear) { r[2] = gear; r[4] = now; dirty = true; changed++; }
      } else if (!seenNew[k]) { seenNew[k] = true; add.push([id, athleteId, gear, '', now]); changed++; }
    });
    if (dirty) sh.getRange(2, 1, vals.length, 5).setValues(vals);
    if (add.length) sh.getRange(sh.getLastRow() + 1, 1, add.length, 5).setValues(add);
    if (dirty || add.length) SpreadsheetApp.flush();
    return changed;
  } finally { try { lock.releaseLock(); } catch (ignore) {} }
}
function garageStravaBikes_(athleteId) {
  try {
    var raw = JSON.parse(scriptProps().getProperty('GARAGE_STRAVA_BIKES_' + athleteId) || 'null');
    if (raw instanceof Array) return { bikes: raw, full: false, at: 0 };
    if (raw && raw.bikes instanceof Array) return raw;
  } catch (e) {}
  return { bikes: [], full: false, at: 0 };
}

/* ---------- State lengkap untuk frontend ---------- */
function garageState_(ss, athleteId, extra) {
  var list = garageReadBikes_(ss, athleteId), bikes = list.map(function(x) { return x.bike; });
  var p = profileMap(ss, athleteId), def = normId_(p.activeGarageBikeId);
  if (!bikes.some(function(b) { return b.id === def && !b.retired; })) { var first = bikes.filter(function(b) { return !b.retired; })[0]; def = first ? first.id : ''; }
  var gearIndex = {}, overrides = {}, tracked = 0;
  garageGearValues_(garageGearSheet_()).forEach(function(r) {
    if (normId_(r[1]) !== athleteId) return;
    var id = normId_(r[0]), gear = normId_(r[2]), ov = normId_(r[3]);
    if (!id) return;
    tracked++;
    if (gear) (gearIndex[gear] = gearIndex[gear] || []).push(id);
    if (ov) overrides[id] = ov;
  });
  var sb = garageStravaBikes_(athleteId), ath = athleteById(athleteId) || {};
  var out = { ok: true, version: 2, bikes: bikes, defaultBikeId: def, activeBikeId: def, gearIndex: gearIndex, overrides: overrides, trackedRides: tracked,
    stravaBikes: sb.bikes || [], stravaBikesFull: !!sb.full, gearSyncedAt: Number(scriptProps().getProperty('GARAGE_GEAR_SYNC_' + athleteId) || 0),
    stravaConnected: !!(ath.stravaAccessToken || ath.stravaRefreshToken), serverTime: new Date().getTime() };
  try { out.stravaShoes = JSON.parse(scriptProps().getProperty('GARAGE_STRAVA_SHOES_' + athleteId) || '[]'); } catch (e) { out.stravaShoes = []; }
  if (extra) Object.keys(extra).forEach(function(k) { out[k] = extra[k]; });
  return out;
}

/* ================= API publik (google.script.run) ================= */
function getBikeGarage(athleteId) {
  ensureRuntimeDatabase();
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (profileMap(ss, athleteId).garageMigratedV2 !== '1') garageWithLock_(function() { garageMigrateLegacy_(ss, athleteId); });
  return garageState_(ss, athleteId);
}
function garageMutate_(athleteId, label, fn) {
  ensureRuntimeDatabase();
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  try {
    return garageWithLock_(function() {
      var ss = SpreadsheetApp.getActiveSpreadsheet();
      garageMigrateLegacy_(ss, athleteId);
      var extra = fn(ss, garageReadBikes_(ss, athleteId)) || {};
      auditEvent('GARAGE_' + label, athleteId, extra.__audit || '');
      delete extra.__audit;
      return garageState_(ss, athleteId, extra);
    });
  } catch (err) { logError('Garage ' + label, err, athleteId); throw err; }
}
function garageRequireBike_(list, bikeId) { var hit = garageFindBike_(list, bikeId); if (!hit) throw new Error('Sepeda tidak ditemukan. Muat ulang garasi lalu coba lagi.'); return hit; }

/* Tambah / ubah sepeda. input.photo (dataURL) & input.removePhoto opsional.
   Foto diproses SETELAH data sepeda tersimpan, jadi gagal upload foto tidak
   pernah menggagalkan simpan sepeda. */
function garageSaveBike(input, athleteId) {
  input = input || {};
  return garageMutate_(athleteId, 'BIKE_SAVED', function(ss, list) {
    var aid = normId_(athleteId || DEFAULT_ATHLETE_ID), id = normId_(input.id), cur = id ? garageRequireBike_(list, id) : null;
    if (!cur && list.length >= GARAGE_MAX_BIKES) throw new Error('Maksimal ' + GARAGE_MAX_BIKES + ' sepeda per atlet.');
    var bike = garageSanitizeBike_(input, cur ? cur.bike : null);
    if (!bike.name) throw new Error('Nama sepeda wajib diisi.');
    if (bike.gearId) list.forEach(function(x) { if (x.bike.id !== bike.id && x.bike.gearId === bike.gearId) throw new Error('Gear Strava ini sudah ditautkan ke "' + x.bike.name + '". Lepas dulu tautannya di sepeda tersebut.'); });
    if (!cur) {
      // Titik awal hitungan umur part untuk sepeda baru.
      var today = garageToday_();
      bike.parts.forEach(function(pt) {
        if (input.partsBaseline === 'now') { pt.trackBy = 'date'; pt.installedDate = today; pt.installedKm = bike.offsetKm; }
        // Tanggal beli jadi titik awal jadwal berbasis hari hanya jika sepeda relatif baru (<1 tahun);
        // untuk sepeda lama tanggal servis terakhir tidak diketahui, jadi kriteria hari diabaikan.
        else if (bike.purchaseDate && bike.purchaseDate >= appDateKey_(new Date(new Date().getTime() - 365 * 86400000))) pt.installedDate = bike.purchaseDate;
      });
    }
    garageWriteBike_(ss, aid, bike, cur ? cur.row : 0);
    var photoError = '';
    if (input.removePhoto && bike.photoId) { trashBikePhotoFile_(bike.photoId); bike.photoId = ''; garageWriteBike_(ss, aid, bike, garageFindBike_(garageReadBikes_(ss, aid), bike.id).row); }
    if (String(input.photo || '').indexOf('data:image') === 0) {
      try {
        var oldPhoto = bike.photoId;
        bike.photoId = saveBikePhotoToDrive_(bike.id, input.photo);
        garageWriteBike_(ss, aid, bike, garageFindBike_(garageReadBikes_(ss, aid), bike.id).row);
        if (oldPhoto && oldPhoto !== bike.photoId) trashBikePhotoFile_(oldPhoto);
