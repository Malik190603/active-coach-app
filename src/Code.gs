}

/* ---------- Helper: render grafik sungguhan (PNG) pakai Charts service bawaan Apps Script ---------- */
function chartLabel_(k) { var dt = new Date(k + 'T00:00:00'); return dt.getDate() + '/' + (dt.getMonth() + 1); }
function bucketByWeekIfNeeded_(dateKeys, valueByDate, maxPoints) {
  if (dateKeys.length <= maxPoints) return { labels: dateKeys, values: dateKeys.map(function(k) { return valueByDate[k]; }) };
  var buckets = {};
  dateKeys.forEach(function(k) {
    var dt = new Date(k + 'T00:00:00'), day = (dt.getDay() + 6) % 7; dt.setDate(dt.getDate() - day);
    var wk = iso(dt);
    buckets[wk] = (buckets[wk] || 0) + valueByDate[k];
  });
  var keys = Object.keys(buckets).sort();
  return { labels: keys, values: keys.map(function(k) { return buckets[k]; }) };
}
function buildColumnChartImage_(labels, values, opts) {
  opts = opts || {};
  try {
    var dataTable = Charts.newDataTable().addColumn(Charts.ColumnType.STRING, opts.xTitle || 'Tanggal').addColumn(Charts.ColumnType.NUMBER, opts.yTitle || 'Nilai');
    labels.forEach(function(l, i) { dataTable.addRow([String(l), Number(values[i]) || 0]); });
    var chart = Charts.newColumnChart()
      .setDataTable(dataTable.build())
      .setDimensions(620, 260)
      .setColors([opts.color || '#fc4c02'])
      .setOption('legend', 'none')
      .setOption('backgroundColor', '#ffffff')
      .setOption('hAxis', { textStyle: { fontSize: 9, color: '#767680' }, slantedText: true, slantedTextAngle: 45 })
      .setOption('vAxis', { textStyle: { fontSize: 9, color: '#767680' }, title: opts.yTitle || '' })
      .setOption('chartArea', { left: 50, top: 20, width: '85%', height: '65%' })
      .build();
    return 'data:image/png;base64,' + Utilities.base64Encode(chart.getAs('image/png').getBytes());
  } catch (err) { return ''; }
}
function buildLineChartImage_(labels, seriesMap, opts) {
  opts = opts || {};
  try {
    var names = Object.keys(seriesMap);
    var builder = Charts.newDataTable().addColumn(Charts.ColumnType.STRING, 'Tanggal');
    names.forEach(function(n) { builder.addColumn(Charts.ColumnType.NUMBER, n); });
    labels.forEach(function(l, i) {
      var row = [String(l)];
      names.forEach(function(n) { row.push(Number(seriesMap[n][i]) || 0); });
      builder.addRow(row);
    });
    var chart = Charts.newLineChart()
      .setDataTable(builder.build())
      .setDimensions(620, 260)
      .setColors(opts.colors || ['#3a1240', '#fc4c02', '#1a9c5b'])
      .setLegendPosition(Charts.Position.BOTTOM)
      .setOption('backgroundColor', '#ffffff')
      .setOption('curveType', 'function')
      .setOption('hAxis', { textStyle: { fontSize: 9, color: '#767680' }, slantedText: true, slantedTextAngle: 45 })
      .setOption('vAxis', { textStyle: { fontSize: 9, color: '#767680' } })
      .setOption('chartArea', { left: 50, top: 20, width: '85%', height: '60%' })
      .build();
    return 'data:image/png;base64,' + Utilities.base64Encode(chart.getAs('image/png').getBytes());
  } catch (err) { return ''; }
}

/* ---------- Fitur 34: laporan PDF sesuai filter dashboard (unduh langsung, tanpa email) ---------- */
function generateReportPdf(filter, athleteId) {
  filter = filter || {};
  athleteId = String(athleteId || DEFAULT_ATHLETE_ID);
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var p = profileMap(ss, athleteId);
  var name = p.nama || 'Athlete';
  var allLogs = readAthleteLogs(ss, athleteId);
  var today = new Date();
  var from = filter.from || '', to = filter.to || '', sport = filter.sport || 'All';
  var logs = allLogs.filter(function(x) { return (!from || x.date >= from) && (!to || x.date <= to) && (!sport || sport === 'All' || x.sport === sport); }).sort(function(a, b) { return a.date.localeCompare(b.date); });

  var metrics = resolveAthleteMetrics(p, allLogs);
  var loadSeries = computeLoadSeries(allLogs, metrics, 42);
  var latest = loadSeries[loadSeries.length - 1] || { ctl: 0, atl: 0, tsb: 0 };
  var recommendation = trainingRecommendation(latest.tsb);
  var analytics = buildAnalytics(allLogs, metrics);
  var vo2max = estimateVO2max(allLogs, metrics);
  var hrZones = buildHrZones(metrics.hrMax, metrics.hrRest, metrics.hrMethod, { mode: p.hrZoneMode || 'Manual', bounds: [num(p.hrZ2Min) || 118, num(p.hrZ3Min) || 144, num(p.hrZ4Min) || 165, num(p.hrZ5Min) || 184] });
  var hrZoneDist = buildHrZoneDistribution(logs.length ? logs : allLogs, hrZones);
  var records = buildRecords(logs.length ? logs : allLogs);

  var weekStart = startOfMonday(today), weekEnd = new Date(weekStart); weekEnd.setDate(weekEnd.getDate() + 6);
  var week = allLogs.filter(function(x) { return x.date >= iso(weekStart) && x.date <= iso(weekEnd); });
  var weeklyTarget = buildWeeklyTarget(allLogs, today);
  weeklyTarget.cycling.goal = num(p.goalCyclingKm) || 100; weeklyTarget.running.goal = num(p.goalRunningKm) || 10;
  var badges = buildBadges(allLogs, week, weeklyTarget);
  var compliance = computeWeeklyCompliance(p, allLogs, today);
  var dataQuality = buildDataQuality(logs);

  var longThresholds = sportLongThresholds(allLogs);
  var sessionTypeCounts = {};
  logs.forEach(function(x) { var t = classifySessionType(x, hrZones, longThresholds); sessionTypeCounts[t] = (sessionTypeCounts[t] || 0) + 1; });

  var segments = getRecentSegments(athleteId).filter(function(sg) { return (!from || sg.date >= from) && (!to || sg.date <= to); });

  var totalMinutes = logs.reduce(function(s, x) { return s + x.minutes; }, 0);
  var totalDistance = logs.reduce(function(s, x) { return s + x.distance; }, 0);
  var totalElevation = logs.reduce(function(s, x) { return s + x.elevation; }, 0);
  var totalCalories = logs.reduce(function(s, x) { return s + x.calories; }, 0);

  var bySport = {};
  logs.forEach(function(x) { var b = bySport[x.sport] = bySport[x.sport] || { count: 0, distance: 0, minutes: 0, elevation: 0 }; b.count++; b.distance += x.distance; b.minutes += x.minutes; b.elevation += x.elevation; });

  var byDate = {};
  logs.forEach(function(x) { byDate[x.date] = (byDate[x.date] || 0) + x.distance; });
  var dateKeys = Object.keys(byDate).sort();

  // Grafik Volume Harian: PNG asli (Charts service) - dibucket per minggu kalau rentangnya panjang, biar sumbu-X tetap terbaca.
  var volBucket = bucketByWeekIfNeeded_(dateKeys, byDate, 21);
  var volumeChartImg = volBucket.labels.length ? buildColumnChartImage_(volBucket.labels.map(chartLabel_), volBucket.values, { yTitle: 'Jarak (km)', color: '#fc4c02' }) : '';

  // Grafik Tren CTL/ATL/TSB: PNG asli, 42 hari terakhir.
  var trendSeries = loadSeries.slice(-42);
  var trendChartImg = trendSeries.length ? buildLineChartImage_(trendSeries.map(function(x) { return chartLabel_(x.date); }), { CTL: trendSeries.map(function(x) { return x.ctl; }), ATL: trendSeries.map(function(x) { return x.atl; }), TSB: trendSeries.map(function(x) { return x.tsb; }) }) : '';

  var html = buildReportHtml_({
    name: name, from: from, to: to, sport: sport,
    sessions: logs.length, totalMinutes: totalMinutes, totalDistance: totalDistance, totalElevation: totalElevation, totalCalories: totalCalories,
    bySport: bySport, logs: logs, dateKeys: dateKeys, byDate: byDate,
    ctl: latest.ctl, atl: latest.atl, tsb: latest.tsb, recommendation: recommendation,
    metrics: metrics, analytics: analytics, vo2max: vo2max, hrZones: hrZones, hrZoneDist: hrZoneDist,
    records: records, badges: badges, compliance: compliance, dataQuality: dataQuality,
    sessionTypeCounts: sessionTypeCounts, segments: segments,
    volumeChartImg: volumeChartImg, trendChartImg: trendChartImg
  });

  var blob = Utilities.newBlob(html, MimeType.HTML, 'laporan.html').getAs(MimeType.PDF);
  var rangeTag = (from || 'awal') + '_sd_' + (to || 'sekarang');
  var filename = 'active-coach-laporan-' + rangeTag + '.pdf';
  return { base64: Utilities.base64Encode(blob.getBytes()), filename: filename, mimeType: 'application/pdf' };
}

function buildReportHtml_(d) {
