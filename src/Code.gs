    else rest += Math.min(dur, 7200);
  };
  for (var i = 1; i < n; i++) {
    var gap = t[i] - t[i - 1], moved = d[i] - d[i - 1];
    if (gap >= 15 && moved < 15 && inStop < 0) { close(i - 1, i, gap); continue; } // auto-pause
    if (still(i)) { if (inStop < 0) inStop = i; }
    else if (inStop >= 0) { close(inStop, i, t[i] - t[inStop]); inStop = -1; }
  }
  out.stops = stops; out.stopT = Math.round(traffic); out.restT = Math.round(rest);
}

/* ---------- baca/tulis ---------- */
function proReadAnalysis_(ss, athleteId) {
  var sh = ss.getSheetByName(PRO_SHEETS.analysis), last = sh.getLastRow(), map = {}, rows = {};
  if (last < 2) return { map: map, rows: rows };
  var vals = sh.getRange(2, 1, last - 1, 4).getValues();
  for (var i = 0; i < vals.length; i++) {
    if (normId_(vals[i][1]) !== athleteId) continue;
    var id = normId_(vals[i][0]); rows[id] = i + 2;
    if (Number(vals[i][2]) !== PRO_VERSION) continue;
    try { map[id] = JSON.parse(String(vals[i][3] || '{}')); } catch (e) {}
  }
  return { map: map, rows: rows };
}
function proReadStore_(ss, athleteId) {
  var sh = ss.getSheetByName(PRO_SHEETS.store), last = sh.getLastRow(), out = {};
  if (last < 2) return out;
  sh.getRange(2, 1, last - 1, 3).getValues().forEach(function(r) { if (normId_(r[0]) !== athleteId) return; try { out[normId_(r[1])] = JSON.parse(String(r[2] || 'null')); } catch (e) {} });
  return out;
}

/* ================= API publik ================= */
function proGetState(athleteId) {
  ensureRuntimeDatabase();
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  var ss = proEnsure_(), a = proReadAnalysis_(ss, athleteId), logs = proLogs_(ss, athleteId);
  var pending = logs.filter(function(x) { return !a.map[String(x.stravaId)]; }).length;
  var trig = ScriptApp.getProjectTriggers().some(function(tr) { return tr.getHandlerFunction() === 'proCron'; });
  return { ok: true, version: PRO_VERSION, analysis: a.map, store: proReadStore_(ss, athleteId), pending: pending, total: logs.length, auto: trig, serverTime: new Date().getTime() };
}
/* Analisis N aktivitas terbaru yang belum dianalisis. Dipanggil berulang dari frontend (progress bar) atau trigger. */
function proAnalyzeBatch(athleteId, maxCount, onlyIds) {
  ensureRuntimeDatabase();
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  var started = new Date().getTime(), budget = 250000;
  var cache = CacheService.getScriptCache(), busyKey = 'PRO_BUSY_' + athleteId;
  if (cache.get(busyKey)) return { ok: true, busy: true, entries: {}, remaining: -1 };
  cache.put(busyKey, '1', 300);
  try {
    var ss = proEnsure_(), logs = proLogs_(ss, athleteId), a = proReadAnalysis_(ss, athleteId);
    var only = null; if (onlyIds instanceof Array && onlyIds.length) { only = {}; onlyIds.forEach(function(x) { only[normId_(x)] = true; }); }
    var todo = logs.filter(function(x) { return !a.map[String(x.stravaId)] && (!only || only[String(x.stravaId)]); }).sort(function(x, y) { return y.date.localeCompare(x.date); });
    var batch = todo.slice(0, Math.max(1, Math.min(40, Number(maxCount) || 12)));
    if (!batch.length) return { ok: true, entries: {}, remaining: 0 };
    var ctx = proCtx_(ss, athleteId, readAthleteLogs(ss, athleteId)), metaMap = proFetchMeta_(athleteId, batch), wxCache = {}, entries = {}, sh = ss.getSheetByName(PRO_SHEETS.analysis), writes = [], done = 0, limited = false;
    for (var i = 0; i < batch.length; i++) {
      if (new Date().getTime() - started > budget) break;
      var log = batch[i], id = String(log.stravaId), meta = metaMap[id] || {}, data;
      try {
        var st = stravaFetch('/activities/' + encodeURIComponent(id) + '/streams?keys=' + PRO_STREAM_KEYS + '&key_by_type=true', null, athleteId) || {};
        var wx = null, ll0 = meta.start_latlng && meta.start_latlng.length === 2 ? meta.start_latlng : (st.latlng && st.latlng.data && st.latlng.data[0]);
        if (ll0 && !meta.trainer) { try { wx = proWeatherDay_(ll0[0], ll0[1], String(meta.start_date_local || log.date).slice(0, 10), wxCache); } catch (we) { console.log('Cuaca gagal: ' + we); } }
        data = proAnalyzeStreams_(log, meta, st, ctx, wx);
      } catch (err) {
        if (String(err).indexOf('429') >= 0) { limited = true; break; } // rate limit Strava: lanjut di batch berikutnya
        data = { v: PRO_VERSION, sp: log.sport, err: String(err && err.message || err).slice(0, 200) };
      }
      entries[id] = data; done++;
      writes.push([id, athleteId, PRO_VERSION, JSON.stringify(data).slice(0, 49000), new Date(), a.rows[id] || 0]);
    }
    var appends = writes.filter(function(r) { return !r[5]; }).map(function(r) { return r.slice(0, 5); });
    writes.filter(function(r) { return r[5]; }).forEach(function(r) { sh.getRange(r[5], 1, 1, 5).setValues([r.slice(0, 5)]); });
    if (appends.length) sh.getRange(sh.getLastRow() + 1, 1, appends.length, 5).setValues(appends);
    SpreadsheetApp.flush();
    return { ok: true, entries: entries, done: done, remaining: Math.max(0, todo.length - done), rateLimited: limited };
  } catch (err2) { logError('Pro analyze', err2, athleteId); throw err2; }
  finally { cache.remove(busyKey); }
}
function proFetchMeta_(athleteId, batch) {
  var dates = batch.map(function(x) { return x.date; }).sort(), map = {}, want = {};
  batch.forEach(function(x) { want[String(x.stravaId)] = true; });
  var after = Math.floor(new Date(dates[0] + 'T00:00:00Z').getTime() / 1000) - 2 * 86400, before = Math.floor(new Date(dates[dates.length - 1] + 'T00:00:00Z').getTime() / 1000) + 3 * 86400;
  for (var page = 1; page <= 6; page++) {
    var items = [];
    try { items = stravaFetch('/athlete/activities?after=' + after + '&before=' + before + '&per_page=200&page=' + page, null, athleteId) || []; } catch (e) { break; }
    items.forEach(function(a) { if (want[String(a.id)]) map[String(a.id)] = { start_date_local: a.start_date_local, start_latlng: a.start_latlng, moving_time: a.moving_time, elapsed_time: a.elapsed_time, trainer: a.trainer, commute: a.commute, gear_id: a.gear_id, sport_type: a.sport_type || a.type }; });
    if (items.length < 200 || Object.keys(map).length >= batch.length) break;
  }
  return map;
}
function proReanalyze(stravaId, athleteId) {
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  var ss = proEnsure_(), a = proReadAnalysis_(ss, athleteId), row = a.rows[normId_(stravaId)];
  if (row) ss.getSheetByName(PRO_SHEETS.analysis).deleteRow(row);
  return proAnalyzeBatch(athleteId, 1, [normId_(stravaId)]);
}
/* Trigger per jam: analisis otomatis semua atlet yang terhubung Strava. */
function proCron() {
  var started = new Date().getTime();
  athleteRows().forEach(function(r) {
    if (new Date().getTime() - started > 240000) return;
    if (!r[5] && !r[6]) return;
    try { proAnalyzeBatch(String(r[0]), 20); } catch (e) { logError('Pro cron', e, String(r[0])); }
  });
}
function proSetAuto(on, athleteId) {
  var has = ScriptApp.getProjectTriggers().filter(function(tr) { return tr.getHandlerFunction() === 'proCron'; });
  if (on && !has.length) ScriptApp.newTrigger('proCron').timeBased().everyHours(1).create();
  if (!on) has.forEach(function(tr) { ScriptApp.deleteTrigger(tr); });
  return { ok: true, auto: !!on };
}
function proStoreSet(key, data, athleteId) {
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID); key = normId_(key);
  if (!PRO_STORE_KEY_RE.test(key)) throw new Error('Kunci penyimpanan tidak dikenal: ' + key);
  var json = JSON.stringify(data === undefined ? null : data);
  if (json.length > 45000) throw new Error('Data terlalu besar (' + json.length + ' karakter).');
  var lock = LockService.getScriptLock(); try { lock.waitLock(15000); } catch (e) { throw new Error('Server sibuk, coba lagi.'); }
  try {
    var ss = proEnsure_(), sh = ss.getSheetByName(PRO_SHEETS.store), last = sh.getLastRow(), row = 0;
    if (last >= 2) { var vals = sh.getRange(2, 1, last - 1, 2).getValues(); for (var i = 0; i < vals.length; i++) if (normId_(vals[i][0]) === athleteId && normId_(vals[i][1]) === key) { row = i + 2; break; } }
    var values = [[athleteId, key, json, new Date()]];
    if (row) sh.getRange(row, 1, 1, 4).setValues(values); else sh.getRange(sh.getLastRow() + 1, 1, 1, 4).setValues(values);
    return { ok: true, key: key, data: JSON.parse(json) };
  } finally { try { lock.releaseLock(); } catch (x) {} }
}
function proStoreDelete(key, athleteId) {
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID); key = normId_(key);
  var ss = proEnsure_(), sh = ss.getSheetByName(PRO_SHEETS.store), last = sh.getLastRow();
  if (last >= 2) { var vals = sh.getRange(2, 1, last - 1, 2).getValues(); for (var i = vals.length - 1; i >= 0; i--) if (normId_(vals[i][0]) === athleteId && normId_(vals[i][1]) === key) sh.deleteRow(i + 2); }
  return { ok: true, key: key };
}
/* Prakiraan 7 hari (per jam) untuk jendela ride, event, dan pacing. */
function proForecast(lat, lng) {
  lat = Number(lat); lng = Number(lng);
  if (!isFinite(lat) || !isFinite(lng)) throw new Error('Lokasi tidak valid.');
  var key = 'PRO_FC_' + proR_(lat, 2) + '_' + proR_(lng, 2), cache = CacheService.getScriptCache(), hit = cache.get(key);
  if (hit) return JSON.parse(hit);
  var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + proR_(lat, 3) + '&longitude=' + proR_(lng, 3) +
    '&hourly=temperature_2m,apparent_temperature,relative_humidity_2m,dew_point_2m,precipitation_probability,precipitation,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m,is_day,uv_index' +
    '&daily=sunrise,sunset&forecast_days=16&timezone=auto&wind_speed_unit=kmh';
  var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
  if (res.getResponseCode() !== 200) throw new Error('Prakiraan cuaca gagal (' + res.getResponseCode() + ')');
  var j = JSON.parse(res.getContentText()), out = { tz: j.timezone, hourly: j.hourly, daily: j.daily, at: new Date().getTime() };
  var s = JSON.stringify(out);
  if (s.length < 95000) cache.put(key, s, 1800);
  return out;
}
function proGeocode(q) {
  q = String(q || '').trim(); if (q.length < 2) return [];
  var res = UrlFetchApp.fetch('https://geocoding-api.open-meteo.com/v1/search?count=6&language=id&format=json&name=' + encodeURIComponent(q), { muteHttpExceptions: true });
  if (res.getResponseCode() !== 200) return [];
  return (JSON.parse(res.getContentText()).results || []).map(function(r) { return { name: r.name, admin: r.admin1 || '', country: r.country || '', lat: r.latitude, lng: r.longitude }; });
}
/* Stream lengkap (diperkecil) untuk ghost ride, peta interaktif, dan pacer. */
function proGetStreams(stravaIds, athleteId) {
  athleteId = normId_(athleteId || DEFAULT_ATHLETE_ID);
  var ids = (stravaIds instanceof Array ? stravaIds : [stravaIds]).map(normId_).filter(function(x) { return /^\d{3,20}$/.test(x); }).slice(0, 2), out = {};
  ids.forEach(function(id) {
    var st = stravaFetch('/activities/' + id + '/streams?keys=time,distance,latlng,altitude,velocity_smooth,heartrate,watts,cadence&key_by_type=true', null, athleteId) || {};
    var n = st.time && st.time.data ? st.time.data.length : 0, step = Math.max(1, Math.ceil(n / 4000)), o = {};
    Object.keys(st).forEach(function(k) { var arr = st[k].data || []; o[k] = step > 1 ? arr.filter(function(_, i) { return i % step === 0 || i === arr.length - 1; }) : arr; });
    out[id] = o;
  });
  return out;
}
/* Rencana (plan) untuk tanggal tertentu, dari arsip MenuPlan. */
function proPlanForDate(date, athleteId) {
