  logs.forEach(function(x) { x.sessionType = classifySessionType(x, hrZones, longThresholds); });
  // Fitur 27: estimasi VO2max dari pace lari terbaik + rasio HRmax/HRrest.
  var vo2max = estimateVO2max(logs, metrics);
  return {
    profile: p, today: todayKey,
    metrics: metrics,
    logs: logs.slice(-MAX_ROWS).reverse(),
    plan: plan, todayPlan: todayPlan, todayActual: todayActual, dashboardPlan: dashboardPlan, dashboardPlanDay: todayActual.length ? 'Besok' : 'Hari ini', next: plan.slice(1, 7),
    stats: { weeklyMinutes: week.reduce(function(a, x) { return a + x.minutes; }, 0), weeklySessions: week.length },
    trainingLoad: { ctl: latest.ctl, atl: latest.atl, tsb: latest.tsb, series: loadSeries.slice(-28) },
    recommendation: recommendation,
    sports: { cycling: logs.filter(function(x) { return x.sport === 'Cycling'; }).length, running: logs.filter(function(x) { return x.sport === 'Running'; }).length },
    hrZones: hrZones,
    analytics: analytics,
    vo2max: vo2max,
    planAdaptation: { note: generatedPlan.adaptNote || '', fatigueMode: generatedPlan.fatigueMode || '', compliance: compliance },
    dataQuality: buildDataQuality(logs),
    records: buildRecords(logs),
    planActual: plan.map(function(x) { var items = logs.filter(function(a) { return a.date === x.date; }), minutes = items.reduce(function(sum, a) { return sum + a.minutes; }, 0), hrMinutes = items.filter(function(a) { return a.avgHr > 0; }).reduce(function(sum, a) { return sum + a.minutes; }, 0), weightedHr = items.reduce(function(sum, a) { return sum + a.avgHr * a.minutes; }, 0), averageHr = hrMinutes ? weightedHr / hrMinutes : 0; return { date: x.date, minutes: minutes, distance: items.reduce(function(sum, a) { return sum + a.distance; }, 0), avgHr: averageHr ? Math.round(averageHr) : 0, hrZone: averageHr ? hrZoneForValue(averageHr, hrZones) : '-', count: items.length }; }),
    calendar: buildCalendar(logs, metrics),
    weeklyTarget: weeklyTarget,
    planBuilder: getPlanBuilderData(athleteId),
    planWeekReview: getPlanWeekReview_(athleteId, logs, today),
    weeklyReview: buildWeeklyReview_(athleteId, logs, '', today, p, metrics, hrZones),
    badges: buildBadges(logs, week, weeklyTarget),
    segments: getRecentSegments(athleteId),
    privacy: { hideRoutes: privacy },
    athleteId: athleteId
