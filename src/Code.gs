   - Sheet "Garage": 1 baris = 1 sepeda (JSON kecil per sepeda).
   - Sheet "ActivityGear": StravaActivityId -> GearId Strava (+ override
     manual sepeda per ride). Diisi otomatis saat sync Strava & webhook.
   - Setiap aksi (tambah/ubah sepeda, part, servis, assign ride) = satu
     fungsi server atomik ber-lock yang mengembalikan STATE LENGKAP terbaru,
     jadi frontend tidak pernah mengirim seluruh garasi.
   - KM sepeda dihitung otomatis dari ride yang ter-attribute ke sepeda
     (gear Strava > override manual > sepeda utama).
   - Foto tetap di Google Drive (folder ActiveCoach_BikePhotos).
   ===================================================================== */
var GARAGE_HEADERS = ['BikeId', 'AthleteId', 'Data', 'UpdatedAt'];
var ACTIVITY_GEAR_HEADERS = ['StravaActivityId', 'AthleteId', 'GearId', 'BikeOverride', 'UpdatedAt'];
var GARAGE_MAX_BIKES = 15, GARAGE_MAX_PARTS = 60, GARAGE_MAX_HISTORY = 300, GARAGE_CELL_LIMIT = 48000;
var GARAGE_BIKE_TYPES = ['road', 'gravel', 'mtb', 'tt', 'hybrid', 'folding', 'ebike', 'other'];
var GARAGE_PART_GROUPS = ['drivetrain', 'brake', 'wheel', 'cockpit', 'frame', 'care', 'other'];
var GARAGE_SERVICE_TYPES = ['service', 'replace', 'upgrade', 'check', 'clean', 'repair'];
var GARAGE_NO_BIKE = '__none__';

/* ---------- Foto sepeda di Google Drive ---------- */
var BIKE_PHOTO_FOLDER = 'ActiveCoach_BikePhotos';
function bikePhotoFolder_() {
  var it = DriveApp.getFoldersByName(BIKE_PHOTO_FOLDER);
  if (it.hasNext()) return it.next();
  return DriveApp.createFolder(BIKE_PHOTO_FOLDER);
}
function bikePhotoIsMine_(file) {
  var folderId = bikePhotoFolder_().getId(), parents = file.getParents();
  while (parents.hasNext()) if (parents.next().getId() === folderId) return true;
  return false;
}
function trashBikePhotoFile_(fileId) {
  try {
    fileId = String(fileId || '').trim();
    if (!/^[\w-]{10,}$/.test(fileId)) return;
    var f = DriveApp.getFileById(fileId);
    if (bikePhotoIsMine_(f)) f.setTrashed(true);
  } catch (e) {}
}
function saveBikePhotoToDrive_(bikeId, dataUrl) {
  var m = String(dataUrl || '').match(/^data:image\/[\w.+-]+;base64,(.+)$/);
  if (!m) throw new Error('Format foto tidak dikenali.');
  var bytes = Utilities.base64Decode(m[1]);
  if (bytes.length > 1048576) throw new Error('Foto kebesaran (' + Math.round(bytes.length / 1024) + ' KB, maks 1 MB).');
  var f = bikePhotoFolder_().createFile(Utilities.newBlob(bytes, 'image/jpeg', 'bike_' + normId_(bikeId) + '_' + new Date().getTime() + '.jpg'));
  f.setDescription('Active Coach bike photo');
  return f.getId();
}
function getBikePhotoContent(photoId, athleteId) {
  photoId = String(photoId || '').trim();
  if (!/^[\w-]{10,}$/.test(photoId)) throw new Error('ID foto tidak valid.');
  var f = DriveApp.getFileById(photoId);
  if (!bikePhotoIsMine_(f)) throw new Error('Foto tidak ditemukan.');
  return 'data:image/jpeg;base64,' + Utilities.base64Encode(f.getBlob().getBytes());
}
function deleteBikePhoto(photoId, athleteId) { trashBikePhotoFile_(photoId); return { ok: true }; }

/* ---------- Helper umum ---------- */
function gStr_(v, n) { return String(v === undefined || v === null ? '' : v).replace(/[\u0000-\u001f]/g, ' ').trim().slice(0, n || 200); }
function gNum_(v, max) { var n = Number(v); if (!isFinite(n) || n < 0) n = 0; if (max && n > max) n = max; return Math.round(n * 100) / 100; }
