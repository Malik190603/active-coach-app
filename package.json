{
  "name": "active-coach-app",
  "version": "1.0.0",
  "private": true,
  "description": "Active Coach - aplikasi Android (Capacitor) dengan backend Supabase",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:open": "npx cap open android",
    "android:debug": "npm run build && npm run android:prepare && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "chart.js": "4.4.4",
    "html2pdf.js": "0.10.3",
    "leaflet": "1.9.4",
    "three": "0.128.0"
  }
}