{
  "appId": "com.activecoach.app",
  "appName": "Active Coach",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0e0e14"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_ac",
      "iconColor": "#FC4C02"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 20000,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "statsUrl": "",
      "updateUrl": "",
      "channelUrl": "",
      "allowModifyUrl": false,
      "shakeMenu": false,
      "keepUrlPathAfterReload": false
    }
  }
}
